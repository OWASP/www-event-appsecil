source 'https://rubygems.org'

# Use the GitHub Pages Jekyll version without its optional plugin bundle.
gem 'jekyll', '= 3.10.0'
gem 'liquid', '= 4.0.4'
gem 'jekyll-redirect-from', '= 0.16.0'
gem 'kramdown-parser-gfm'
gem 'csv'
gem 'webrick'
gem 'base64'

# Match the libraries shipped with RubyInstaller 4.0 to avoid compiling copies.
gem 'json', '= 2.18.0'
gem 'bigdecimal', '= 4.0.1'
